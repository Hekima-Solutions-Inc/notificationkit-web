{
  "name": "notificationkit-web",
  "version": "0.1.4",
  "description": "Web SDK for NotifyKit - push notifications, in-app messages, and user engagement",
  "type": "module",
  "main": "dist/notificationkit.cjs",
  "module": "dist/notificationkit.mjs",
  "types": "dist/notificationkit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/notificationkit.d.ts",
      "import": "./dist/notificationkit.mjs",
      "require": "./dist/notificationkit.cjs"
    },
    "./worker": "./dist/NotificationKitWorker.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "notifications",
    "push",
    "web-push",
    "in-app-messages",
    "sdk"
  ],
  "scripts": {
    "build:sdk": "LIB=sdk vite build",
    "build:sw": "LIB=worker vite build",
    "build": "npm run build:sdk && npm run build:sw",
    "publish": "npm run build && npm publish",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "terser": "^5.46.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.1.1"
  }
}
